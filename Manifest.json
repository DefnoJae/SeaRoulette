{
  "id": "searoulette",
  "name": "SeaRoulette",
  "version": "0.1.19",
  "manifestURI": "https://raw.githubusercontent.com/DefnoJae/SeaRoulette/main/Manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Randomly pick anime from your AniList lists using dub, rating and genre filters.",
  "author": "DefnoJae",
