  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "anilist",
        "storage"
      ],
      "allow": {
        "networkAccess": {
          "allowedDomains": [
            "raw.githubusercontent.com"
          ]
        }
      }
    }
  },
  "icon": "https://raw.githubusercontent.com/DefnoJae/SeaRoulette/main/assets/searoulette-strawhat.png"
}
